# FinSight AI - Environment Configuration Template
# Copy this file to backend/.env and fill in your values.
# NEVER commit real .env files to Git.

NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:5173

# MongoDB Atlas or Local connection URI
# Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/finsight?retryWrites=true&w=majority
MONGODB_URI=

# Authentication Secret (Used for JWT signing in upcoming Auth phase)
JWT_SECRET=

# Python ML Microservice Configuration (FastAPI)
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_API_KEY=

# AI Copilot Provider API Key
LLM_API_KEY=
